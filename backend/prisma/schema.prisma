generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum StockStatus {
  EN_STOCK
  AGOTADO
  BAJO_PEDIDO
}

enum PaymentMethod {
  YAPE
  PLIN
}

enum OrderStatus {
  PENDIENTE_VERIFICACION
  PAGO_VERIFICADO
  RECHAZADO
  ENVIADO
  ENTREGADO
}

/// Ajustes editables de la tienda (una sola fila, id = "main").
/// Hoy: datos de pago que el cliente cambia desde el panel sin tocar código.
model StoreSettings {
  id           String   @id @default("main")
  businessName String? // nombre del titular que se muestra al pagar (empresa)
  yapeNumber   String?
  yapeQrUrl    String?
  plinNumber   String?
  plinQrUrl    String?
  updatedAt    DateTime @updatedAt

  @@map("store_settings")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?
  order         Int            @default(0)
  subcategories Subcategory[]
  products      Product[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("categories")
}

model Subcategory {
  id         String    @id @default(cuid())
  slug       String
  name       String
  order      Int       @default(0)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  sku            String        @unique
  name           String
  price          Decimal       @db.Decimal(10, 2)
  // Precio anterior (tachado). Si está y es mayor que `price`, el producto
  // se muestra "en oferta" y entra en la sección Ofertas de la home.
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  stock          StockStatus   @default(EN_STOCK)
  spec           String?
  description    String?
  // Ficha ampliada opcional (INFO / VENTAJAS / BENEFICIOS / APLICACIONES /
  // ESPECIFICACIONES TÉCNICAS). Forma validada en products.controller.ts.
  // Si es null, la página del producto usa el diseño simple.
  details        Json?
  videoUrl       String?
  category       Category      @relation(fields: [categoryId], references: [id])
  categoryId     String
  subcategory    Subcategory   @relation(fields: [subcategoryId], references: [id])
  subcategoryId  String
  images         ProductImage[]
  orderItems     OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerName  String
  customerPhone String
  address       String
  district      String?
  paymentMethod PaymentMethod
  receiptUrl    String
  status        OrderStatus   @default(PENDIENTE_VERIFICACION)
  total         Decimal       @db.Decimal(10, 2)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  // Relación opcional: si el producto se elimina del catálogo, este ítem
  // conserva su copia de nombre/precio/cantidad y `productId` queda en null
  // (onDelete: SetNull). Así el historial de pedidos nunca se rompe.
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  name      String
  price     Decimal @db.Decimal(10, 2)
  qty       Int

  @@map("order_items")
}
