# Copia este archivo a .env y completa los valores reales.
# .env NO se sube a git; .env.example (esta plantilla) SÍ.

# Cadena de conexión a PostgreSQL.
# - Neon: usa la conexión DIRECTA (sin "-pooler" en el host), termina en ?sslmode=require
# - Local: postgresql://usuario:password@localhost:5432/electrostock
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Clave secreta para firmar los tokens JWT. Genera una propia y única:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Puerto donde corre la API. En local 4000; en DigitalOcean App Platform
# lo asigna la plataforma (8080) y el código lo respeta solo.
PORT=4000

# Orígenes permitidos para CORS (el frontend), separados por coma si son varios.
# En producción: la URL de Vercel (y luego tu dominio).
CORS_ORIGIN="http://localhost:3000"

# --- Cloudinary: almacenamiento de imágenes (fotos de producto y comprobantes) ---
# Se sacan del Dashboard de Cloudinary → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Seed (npm run seed) ---
# SEED_MODE=admin  -> solo crea el usuario admin (catálogo vacío, para producción).
# Sin definir       -> siembra datos de ejemplo (para desarrollo local).
SEED_MODE=""
# Credenciales del primer usuario admin. Si no se definen, usa
# admin@electrostock.pe / admin1234 (SOLO para local).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
